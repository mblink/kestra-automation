# Copy to .env and fill in real values. .env is gitignored.

# Kestra's own encryption key, backs the secret() function. Generate with:
#   openssl rand -base64 32
KESTRA_SECRET_KEY=

# Base64-encoded SSH private key for the 'bldeploy' remote-exec user (matches
# salt://keys/id_rsa_bldeploy in the salt repo), used by io.kestra.plugin.fs.ssh.Command
# flows as {{ secret('SSH_PRIVATE_KEY') }}. Encode with:
#   base64 -i /path/to/id_rsa_bldeploy | tr -d '\n'
SECRET_SSH_PRIVATE_KEY=

# SendGrid API key, used directly by io.kestra.plugin.notifications.sendgrid.
# SendGridMailSend (SendGrid's HTTPS API, not SMTP) — matches
# pillar['postfix-sendgrid']['password'] / salt/kestra's kestra-postfix-auth state,
# which now writes only this key to /var/lib/kestra/.postfix-auth (no smtp-host/port).
# Unlike the earlier SMTP-relay design, this is reachable over the public internet —
# so mail-notification testing is actually possible locally on this Mac, once filled in.
SECRET_SENDGRID_API_KEY=

# SSH (not TLS) private key with read access to github.com/jeffdyke/kestra-automation,
# used ONLY by ops/kestra-bootstrap.yml (a local-dev convenience flow — production sync
# uses a host-level git pull + `kestra flow namespace update`, per the salt/kestra state).
SECRET_GITHUB_SSH_PRIVATE_KEY=
